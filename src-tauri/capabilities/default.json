{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "allow-runtime-snapshot-read",
    "allow-runtime-refresh",
    "allow-refresh-interval-set",
    "allow-operational-settings-read",
    "allow-operational-settings-manage",
    "allow-codex-accounts-read",
    "allow-codex-accounts-manage",
    "allow-usage-intelligence-read",
    "allow-usage-intelligence-manage",
    "allow-history-read",
    "allow-history-manage",
    "allow-usage-analytics-read",
    "allow-provider-cache-manage",
    "allow-diagnostics-export",
    "allow-usage-export",
    "allow-manual-provider-refresh",
    "autostart:default",
    "notification:default",
    "updater:default",
    "process:default"
  ]
}

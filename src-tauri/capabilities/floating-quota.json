{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating-quota",
  "description": "Compact always-on-top quota bar",
  "windows": ["floating-quota"],
  "permissions": [
    "core:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "allow-runtime-snapshot-read",
    "allow-runtime-refresh",
    "allow-refresh-interval-set",
    "allow-operational-settings-read",
    "allow-codex-accounts-read",
    "allow-usage-intelligence-read",
    "allow-manual-provider-refresh",
    "allow-open-main-window",
    "allow-floating-drag-lifecycle",
    "allow-floating-monitor-observer",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-is-visible",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "core:window:allow-unminimize",
    "core:window:allow-set-focusable",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window"
  ]
}
